rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isProviderMember(providerId) {
      return signedIn()
        && exists(/databases/$(database)/documents/providerMembers/$(providerId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/providerMembers/$(providerId + '_' + request.auth.uid)).data.status == 'ACTIVE';
    }

    match /accounts/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.primaryRole in ['OPERATOR', 'OPERATOR_DRIVER', 'DRIVER', 'SUBSCRIBER']
        && !request.resource.data.roles.hasAny(['ADMIN']);

      allow update: if isOwner(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.roles.hasAll(resource.data.roles)
        && !request.resource.data.roles.hasAny(['ADMIN'])
        && request.resource.data.primaryRole in request.resource.data.roles
        && request.resource.data.providerId in [resource.data.providerId, request.auth.uid]
        && request.resource.data.driverId in [resource.data.driverId, request.auth.uid]
        && request.resource.data.subscriberId in [resource.data.subscriberId, request.auth.uid];

      allow delete: if false;
    }

    match /accountPrivate/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isOwner(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'ownerAccountId', 'displayName', 'registrationNumber',
          'vehicleType', 'makeModel', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == vehicleId
        && request.resource.data.ownerAccountId == request.auth.uid
        && exists(/databases/$(database)/documents/providers/$(request.auth.uid))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.registrationNumber is string
        && request.resource.data.registrationNumber.matches('^[A-Z0-9]{4,15}$')
        && request.resource.data.vehicleType is string
        && request.resource.data.vehicleType.size() > 0
        && request.resource.data.vehicleType.size() <= 30
        && (request.resource.data.makeModel == null
          || (request.resource.data.makeModel is string
            && request.resource.data.makeModel.size() <= 50))
        && request.resource.data.status == 'ACTIVE';

      allow read: if signedIn()
        && (resource.data.ownerAccountId == request.auth.uid
          || resource.data.status == 'ACTIVE'
          || isAdmin());

      // Vehicle edits must use the future versioned/audited update flow.
      allow update, delete: if false;
    }

    match /vehicleVersions/{versionId} {
      allow create: if signedIn()
        && request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.vehicleId is string
        && request.resource.data.version == 1
        && request.resource.data.reason == 'VEHICLE_CREATED';

      allow read: if signedIn()
        && (resource.data.ownerAccountId == request.auth.uid || isAdmin());

      allow update, delete: if false;
    }

    match /routes/{routeId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'ownerAccountId', 'vehicleId', 'routeName', 'directionType',
          'pairedRouteId', 'creationMethod', 'status', 'learningTripCount',
          'startPoint', 'endPoint', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == routeId
        && request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.routeName is string
        && request.resource.data.routeName.size() > 0
        && request.resource.data.routeName.size() <= 60
        && request.resource.data.directionType in ['OUTBOUND', 'RETURN', 'CUSTOM']
        && request.resource.data.creationMethod == 'RECORDED'
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.learningTripCount == 0
        && request.resource.data.startPoint == null
        && request.resource.data.endPoint == null
        && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId))
        && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.ownerAccountId == request.auth.uid;

      allow read: if signedIn()
        && (resource.data.ownerAccountId == request.auth.uid
          || resource.data.status == 'ACTIVE'
          || isProviderMember(resource.data.ownerAccountId)
          || isAdmin());
      allow update: if signedIn()
        && (resource.data.ownerAccountId == request.auth.uid
          || isProviderMember(resource.data.ownerAccountId))
        && request.resource.data.ownerAccountId == resource.data.ownerAccountId
        && request.resource.data.id == resource.data.id
        && request.resource.data.vehicleId == resource.data.vehicleId
        && request.resource.data.routeName == resource.data.routeName
        && request.resource.data.directionType == resource.data.directionType
        && request.resource.data.creationMethod == resource.data.creationMethod
        && (
          (resource.data.status == 'DRAFT'
            && request.resource.data.status == 'LEARNING'
            && request.resource.data.learningTripCount == 1)
          || (resource.data.status == 'LEARNING'
            && request.resource.data.status == 'LEARNING'
            && request.resource.data.learningTripCount == resource.data.learningTripCount + 1
            && request.resource.data.learningTripCount <= 2)
          || (resource.data.status == 'LEARNING'
            && request.resource.data.status == 'ACTIVE'
            && resource.data.learningTripCount == 2
            && request.resource.data.learningTripCount == 3
            && request.resource.data.learnedPath is list
            && request.resource.data.learnedPath.size() == 40)
        );
      allow delete: if false;
    }

    match /routeVersions/{versionId} {
      allow create: if signedIn()
        && (request.resource.data.ownerAccountId == request.auth.uid
          || isProviderMember(request.resource.data.ownerAccountId))
        && request.resource.data.routeId is string
        && ((request.resource.data.version == 1
            && request.resource.data.reason == 'ROUTE_CREATED')
          || (request.resource.data.version == 2
            && request.resource.data.reason == 'LEARNING_FINALIZED'));

      allow read: if signedIn() && (resource.data.ownerAccountId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /routeLearningTrips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.id == tripId
        && (request.resource.data.ownerAccountId == request.auth.uid
          || isProviderMember(request.resource.data.ownerAccountId))
        && request.resource.data.recordedByAccountId == request.auth.uid
        && request.resource.data.sequence in [1, 2]
        && request.resource.data.points is list
        && request.resource.data.points.size() >= 8
        && exists(/databases/$(database)/documents/routes/$(request.resource.data.routeId))
        && get(/databases/$(database)/documents/routes/$(request.resource.data.routeId)).data.ownerAccountId == request.resource.data.ownerAccountId;
      allow read, delete: if signedIn()
        && (resource.data.ownerAccountId == request.auth.uid
          || isProviderMember(resource.data.ownerAccountId));
      allow update: if false;
    }

    match /providers/{providerId} {
      allow create: if isOwner(providerId)
        && request.resource.data.id == providerId
        && request.resource.data.ownerAccountId == request.auth.uid
        && request.resource.data.status == 'ACTIVE';
      allow read: if signedIn()
        && (resource.data.status == 'ACTIVE' || isOwner(providerId) || isProviderMember(providerId) || isAdmin());
      allow update: if isOwner(providerId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.ownerAccountId == resource.data.ownerAccountId;
      allow delete: if false;
    }

    match /providerMembers/{memberId} {
      allow create: if signedIn()
        && request.resource.data.id == memberId
        && ((request.resource.data.role == 'OWNER'
            && request.resource.data.providerId == request.auth.uid
            && request.resource.data.accountId == request.auth.uid)
          || (request.resource.data.role == 'DRIVER'
            && request.resource.data.accountId == request.auth.uid
            && request.resource.data.inviteId is string
            && exists(/databases/$(database)/documents/driverInvites/$(request.resource.data.inviteId))
            && get(/databases/$(database)/documents/driverInvites/$(request.resource.data.inviteId)).data.status == 'OPEN'
            && get(/databases/$(database)/documents/driverInvites/$(request.resource.data.inviteId)).data.providerId == request.resource.data.providerId));
      allow read: if signedIn()
        && (resource.data.accountId == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());
      allow update: if signedIn()
        && (resource.data.providerId == request.auth.uid || isAdmin())
        && request.resource.data.id == resource.data.id
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.accountId == resource.data.accountId;
      allow delete: if false;
    }

    match /driverInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.createdByAccountId == request.auth.uid
        && exists(/databases/$(database)/documents/providers/$(request.auth.uid))
        && request.resource.data.status == 'OPEN';
      allow get: if signedIn();
      allow list: if isAdmin();
      allow update: if signedIn()
        && resource.data.status == 'OPEN'
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.createdByAccountId == resource.data.createdByAccountId
        && request.resource.data.status == 'ACCEPTED'
        && request.resource.data.acceptedByAccountId == request.auth.uid;
      allow delete: if false;
    }

    match /routeRuns/{runId} {
      allow create: if signedIn()
        && request.resource.data.id == runId
        && request.resource.data.driverAccountId == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && isProviderMember(request.resource.data.providerId)
        && exists(/databases/$(database)/documents/routes/$(request.resource.data.routeId));
      allow read: if signedIn()
        && (resource.data.driverAccountId == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin());
      allow update: if signedIn()
        && resource.data.driverAccountId == request.auth.uid
        && request.resource.data.driverAccountId == resource.data.driverAccountId
        && request.resource.data.routeId == resource.data.routeId
        && request.resource.data.providerId == resource.data.providerId
        && request.resource.data.status in ['ACTIVE', 'COMPLETED'];
      allow delete: if false;
    }

    match /subscriberLocations/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 60
        && request.resource.data.point is map;
      allow delete: if false;
    }

    match /routeSubscriptions/{subscriptionId} {
      allow read: if signedIn()
        && (resource.data.subscriberAccountId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.id == subscriptionId
        && request.resource.data.subscriberAccountId == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.alertMinutes == [6, 3]
        && exists(/databases/$(database)/documents/subscriberLocations/$(request.auth.uid))
        && exists(/databases/$(database)/documents/routes/$(request.resource.data.routeId))
        && get(/databases/$(database)/documents/routes/$(request.resource.data.routeId)).data.status == 'ACTIVE';
      allow update: if signedIn()
        && resource.data.subscriberAccountId == request.auth.uid
        && request.resource.data.subscriberAccountId == request.auth.uid
        && request.resource.data.routeId == resource.data.routeId
        && request.resource.data.status in ['ACTIVE', 'MUTED', 'ENDED'];
      allow delete: if false;
    }

    match /deviceTokens/{tokenId} {
      allow read: if signedIn() && resource.data.accountId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.fcmToken is string
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.enabled == true;
      allow update: if signedIn()
        && resource.data.accountId == request.auth.uid
        && request.resource.data.accountId == request.auth.uid;
      allow delete: if false;
    }

    match /subscriptionAlertStates/{stateId} {
      allow read: if signedIn()
        && resource.data.subscriberAccountId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
