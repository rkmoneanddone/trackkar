rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public-facing account/profile data for the authenticated account itself.
    // Broader provider/driver/subscriber visibility will be added deliberately
    // when those modules are implemented.
    match /accounts/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'ACTIVE';

      allow update: if isOwner(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        // Client cannot self-promote a suspended account.
        && request.resource.data.status == resource.data.status;

      allow delete: if false;
    }

    // Private contact data: only the owning authenticated account.
    match /accountPrivate/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;

      allow update: if isOwner(uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    // Default deny. New TrackKar modules get explicit rules as we build them.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}